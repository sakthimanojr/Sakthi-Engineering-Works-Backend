# ---- Neon PostgreSQL ----
# Pooled connection string (host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# Direct (non-pooled) connection string. Used only by `prisma migrate`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Auth.js ----
# Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Public URL of THIS backend, e.g. https://admin.sakthiengineeringworks.in
AUTH_URL=http://localhost:3001
# Set true when running behind your own proxy/VPS (not needed on Vercel)
AUTH_TRUST_HOST=true

# First admin account. Used ONLY by `npm run db:seed` (re-run to reset the password). Min 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Link with the frontend ----
# Long random secret. Same value as BACKEND_API_KEY in the frontend .env.
FRONTEND_API_KEY=
# Public URL of the frontend; the backend tells it to refresh after you edit projects/gallery.
FRONTEND_URL=http://localhost:3000
# Same value as REVALIDATE_SECRET in the frontend .env.
REVALIDATE_SECRET=

# ---- Enquiry notification email (SMTP) ----
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
